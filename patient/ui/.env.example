# Optional: override the local MediBot FastAPI service URL.
VITE_MEDIBOT_API_URL=http://127.0.0.1:8000/api/v1/chat

# Patient authentication defaults to the local terminal OTP flow. Set this to
# "firebase" only after configuring Firebase Phone Authentication below.
VITE_PATIENT_AUTH_MODE=terminal

# Firebase Web app configuration (public client values; never put Admin SDK
# credentials, service-account keys, or other private backend secrets here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend route that verifies the Firebase ID token and returns the patient
# session/registration response. The provider_code is sent in the same call.
VITE_PATIENT_FIREBASE_EXCHANGE_PATH=/auth/patient/firebase/exchange

# Configure fictional phone numbers and their fixed test codes in the Firebase
# Console. Enter those fixed codes in the normal six-digit code field.
